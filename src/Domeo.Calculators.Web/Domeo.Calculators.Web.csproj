<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Domeo.Calculators.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Domeo.Calculators/Domeo.Calculators.csproj" />
  </ItemGroup>

  <!-- DejaVu Sans: в образе .NET нет шрифтов с кириллицей, поэтому кладём свои.
       Лицензия DejaVu разрешает свободное распространение. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts/DejaVuSans.ttf" LogicalName="Domeo.Calculators.Web.Fonts.DejaVuSans.ttf" />
    <EmbeddedResource Include="Fonts/DejaVuSans-Bold.ttf" LogicalName="Domeo.Calculators.Web.Fonts.DejaVuSans-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

</Project>
