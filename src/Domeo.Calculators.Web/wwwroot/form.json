{
  "title": "Передача проекта в комплектацию",
  "lede": "Опросник заполняет дизайнер при передаче проекта в комплектацию. Готовый лист скачивается в PDF.",
  "source": "Опросник «передача лида в комплектацию.docx», 21.08.2026",
  "sections": [
    {
      "id": "lead",
      "title": "Заявка",
      "fields": [
        { "id": "designer", "label": "Дизайнер", "type": "text" },
        { "id": "client", "label": "ФИО заказчика", "type": "text" },
        { "id": "leadNumber", "label": "Номер лида", "type": "text", "short": true }
      ]
    },
    {
      "id": "general",
      "title": "Общая информация",
      "fields": [
        {
          "id": "objectType", "label": "Тип объекта", "type": "choice",
          "options": ["квартира", "дом/коттедж", "коммерция"]
        },
        { "id": "area", "label": "Площадь, м²", "type": "text", "short": true },
        { "id": "ceiling", "label": "Высота потолков, м", "hint": "чистовой размер", "type": "text", "short": true },
        {
          "id": "condition", "label": "Состояние объекта", "type": "choice",
          "options": ["новостройка (бетон)", "white box", "вторичка"]
        }
      ]
    },
    {
      "id": "budget",
      "title": "Бюджет",
      "fields": [
        {
          "id": "budgetLevel", "label": "Ориентировочный бюджет", "type": "choice",
          "options": ["эконом", "комфорт", "бизнес", "премиум"]
        },
        {
          "id": "priorities", "label": "Приоритеты заказчика", "type": "choice",
          "options": [
            "минимальная цена",
            "оптимальное соотношение цена/качество",
            "бренды и премиальные решения"
          ]
        }
      ]
    },
    {
      "id": "stage",
      "title": "Стадия дизайн-проекта",
      "fields": [
        {
          "id": "approved", "label": "Что согласовано по дизайн-проекту", "type": "multi",
          "options": ["планировка/расстановка", "коллажи", "все чертежи", "визуализации"]
        }
      ]
    },
    {
      "id": "finishes",
      "title": "Отделочные материалы",
      "fields": [
        {
          "id": "walls", "label": "Настенные покрытия", "type": "multi",
          "options": ["покраска", "обои под покраску", "обои", "панели"],
          "other": true
        },
        {
          "id": "floors", "label": "Напольные покрытия", "type": "multi",
          "options": ["кварцвинил", "ламинат", "инженерная доска", "паркет"],
          "other": true
        },
        {
          "id": "furniture", "label": "Мебель корпусная", "type": "multi",
          "options": ["заказная", "модульная"]
        }
      ]
    },
    {
      "id": "lighting",
      "title": "Освещение",
      "fields": [
        {
          "id": "mainLight", "label": "Основное освещение", "type": "multi",
          "options": ["точечное", "трековое"]
        },
        { "id": "plinthLight", "label": "Подсветка плинтуса", "type": "choice", "options": ["да", "нет"] },
        { "id": "ceilingLight", "label": "Потолочная подсветка", "type": "choice", "options": ["да", "нет"] },
        {
          "id": "curtainLight", "label": "Закарнизная подсветка", "hint": "ниша для штор",
          "type": "choice", "options": ["да", "нет"]
        }
      ]
    },
    {
      "id": "door",
      "title": "Входная дверь",
      "fields": [
        {
          "id": "entranceDoor", "label": "Решение по двери", "type": "choice",
          "options": ["под замену", "внутренняя панель на входную дверь", "не меняем"]
        }
      ]
    },
    {
      "id": "heating",
      "title": "Отопление",
      "fields": [
        {
          "id": "radiators", "label": "Радиаторы/конвекторы", "type": "choice",
          "options": ["не меняем", "под замену"]
        }
      ]
    },
    {
      "id": "extra",
      "title": "Материалы и примечания",
      "fields": [
        {
          "id": "references", "label": "Материалы по проекту",
          "hint": "референсы, ссылки на выбранные позиции", "type": "textarea"
        },
        { "id": "notes", "label": "Примечания", "type": "textarea" }
      ]
    }
  ]
}
